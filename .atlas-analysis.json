  "keyFeatures": [
    "All-in-one WireGuard VPN with Web UI",
    "Client management with QR codes and configuration files",
    "Real-time statistics and Tx/Rx charts",
    "Two-factor authentication (2FA)",
    "One-time links and client expiration",
    "Multilanguage support (20+ languages)",
    "Prometheus metrics support",
    "IPv6 and CIDR support",
    "AmneziaWG integration",
    "Gravatar support",
    "Automatic light/dark mode"
  ],
  "publicApiSurface": [
    "POST /api/session - Authentication",
    "GET /api/session - Get session info",
    "DELETE /api/session - Logout",
    "GET /api/admin/interface - Get interface config",
    "POST /api/admin/interface - Update interface config",
    "GET /api/admin/general - Get general settings",
    "POST /api/admin/general - Update general settings",
    "GET /api/admin/hooks - Get hooks",
    "POST /api/admin/hooks - Update hooks",
    "GET /api/admin/userconfig - Get user config",
    "POST /api/admin/userconfig - Update user config",
    "GET /api/client - List clients",
    "POST /api/client - Create client",
    "GET /api/client/:id - Get client",
    "PUT /api/client/:id - Update client",
    "DELETE /api/client/:id - Delete client",
    "GET /api/information - Get system information",
    "GET /api/me - Get current user",
    "POST /api/setup - Initial setup",
    "cli db:admin:reset - Reset admin password",
    "cli db:user:show - Show users",
    "cli db:user:remove - Remove user"
  ]
